// RGBA8 texels to BC7 blocks on the GPU, one invocation per 4x4 block: the second pass of the ASTC decode when
// OOT_ASTC_BC is on (vk_astc.c), so a decoded ASTC texture takes 8 bits per texel in video memory instead of 32, at
// a quality close to the RGBA8 image (BC3's 565 colours and 2-bit indices showed banding). Same bindings and push
// constants as bc3_encode.comp. Texels past the right or bottom edge repeat the last column or row.
//
// Mode 6 only: one subset, RGBA endpoints of 7 bits plus a p-bit each, 4-bit indices. The endpoint line is the
// block's principal axis (power iteration on the RGBA covariance) through its mean, from the smallest to the largest
// projection; each of the four p-bit pairs is tried with every texel on its best of the 16 palette entries
// (exhaustive), then the endpoints are fitted again by least squares to those indices and tried once more; the block
// with the smallest squared error is written. The bytes are what the texels hold, so an sRGB image keeps sRGB-encoded
// values, as BC7_SRGB expects.
// Compiled to runtime/bc7_encode_spv.h by tools/build_shaders.py; vk_astc.c records the dispatch.
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Texels { uint px[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Blocks { uvec4 blk[]; };

layout(push_constant) uniform Params {
    uint in_base;    // first texel of slice 0 (index into px)
    uint out_base;   // first block of slice 0 (uvec4 index into blk)
    uint width, height;
    uint bx;         // blocks per row
    uint bslice;     // blocks per slice
} pc;

const uint W[16] = uint[16](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u, 34u, 38u, 43u, 47u, 51u, 55u, 60u, 64u);

vec4 t[16];
uint best_idx[16], cur_idx[16];
uint wd[4];

vec4 texel(uint x, uint y, uint z) {
    x = min(x, pc.width - 1u), y = min(y, pc.height - 1u);
    return unpackUnorm4x8(px[pc.in_base + (z * pc.height + y) * pc.width + x]) * 255.0;
}

// An 8-bit endpoint to its 7 bits for p-bit p, and back.
uvec4 quant(vec4 e, uint p) { return uvec4(clamp(round((e - float(p)) * 0.5), 0.0, 127.0)); }
uvec4 deq(uvec4 q, uint p) { return q * 2u + p; }

// Squared error of the block on the palette of endpoints a, b (8-bit values); cur_idx: each texel's best entry.
float fit(uvec4 a, uvec4 b) {
    vec4 pal[16];
    for (uint k = 0u; k < 16u; k++) pal[k] = vec4(((64u - W[k]) * a + W[k] * b + 32u) >> 6);
    float err = 0.0;
    for (uint i = 0u; i < 16u; i++) {
        float bd = 1e30;
        uint bk = 0u;
        for (uint k = 0u; k < 16u; k++) {
            vec4 d = pal[k] - t[i];
            float e = dot(d, d);
            if (e < bd) bd = e, bk = k;
        }
        cur_idx[i] = bk;
        err += bd;
    }
    return err;
}

// The best p-bit pair for endpoints e0, e1; updates the block's best (error, quantised endpoints, p-bits, indices).
void try_endpoints(vec4 e0, vec4 e1, inout float best, inout uvec4 q0, inout uvec4 q1, inout uint p0, inout uint p1) {
    e0 = clamp(e0, 0.0, 255.0), e1 = clamp(e1, 0.0, 255.0);
    for (uint p = 0u; p < 4u; p++) {
        uint pa = p & 1u, pb = p >> 1;
        uvec4 a = quant(e0, pa), b = quant(e1, pb);
        float err = fit(deq(a, pa), deq(b, pb));
        if (err < best) {
            best = err, q0 = a, q1 = b, p0 = pa, p1 = pb;
            for (uint i = 0u; i < 16u; i++) best_idx[i] = cur_idx[i];
        }
    }
}

void put(inout uint pos, uint v, uint n) {   // n bits of v at bit pos of the block, LSB first
    uint i = pos >> 5, o = pos & 31u;
    wd[i] |= v << o;
    if (o + n > 32u) wd[i + 1u] |= v >> (32u - o);
    pos += n;
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    uint by = (pc.height + 3u) / 4u;
    if (id.x >= pc.bx || id.y >= by) return;
    vec4 lo = vec4(255.0), hi = vec4(0.0), mean = vec4(0.0);
    for (uint i = 0u; i < 16u; i++) {
        t[i] = texel(id.x * 4u + (i & 3u), id.y * 4u + (i >> 2), id.z);
        lo = min(lo, t[i]), hi = max(hi, t[i]), mean += t[i];
    }
    mean /= 16.0;

    // principal axis: power iteration on the covariance, from the box diagonal
    mat4 cov = mat4(0.0);
    for (uint i = 0u; i < 16u; i++) {
        vec4 d = t[i] - mean;
        cov += outerProduct(d, d);
    }
    vec4 axis = hi - lo;
    for (int it = 0; it < 8; it++) {
        vec4 n = cov * axis;
        float l = length(n);
        if (l < 1e-6) break;
        axis = n / l;
    }
    float al = length(axis);
    axis = al > 1e-6 ? axis / al : vec4(0.0);
    float pmin = 0.0, pmax = 0.0;
    for (uint i = 0u; i < 16u; i++) {
        float p = dot(t[i] - mean, axis);
        pmin = min(pmin, p), pmax = max(pmax, p);
    }

    float best = 1e30;
    uvec4 q0 = uvec4(0u), q1 = uvec4(0u);
    uint p0 = 0u, p1 = 0u;
    try_endpoints(mean + axis * pmin, mean + axis * pmax, best, q0, q1, p0, p1);

    // least squares fit of the endpoints to the chosen indices, then the p-bits again
    if (best > 0.0) {
        float aa = 0.0, ab = 0.0, bb = 0.0;
        vec4 at = vec4(0.0), bt = vec4(0.0);
        for (uint i = 0u; i < 16u; i++) {
            float w = float(W[best_idx[i]]) / 64.0, v = 1.0 - w;
            aa += v * v, ab += v * w, bb += w * w;
            at += v * t[i], bt += w * t[i];
        }
        float det = aa * bb - ab * ab;
        if (abs(det) > 1e-4) {
            vec4 e0 = (at * bb - bt * ab) / det, e1 = (bt * aa - at * ab) / det;
            try_endpoints(e0, e1, best, q0, q1, p0, p1);
        }
    }

    // the anchor (texel 0) is stored with 3 bits: its index must be below 8, else the endpoints swap
    if (best_idx[0] >= 8u) {
        uvec4 s = q0; q0 = q1; q1 = s;
        uint sp = p0; p0 = p1; p1 = sp;
        for (uint i = 0u; i < 16u; i++) best_idx[i] = 15u - best_idx[i];
    }

    wd[0] = 0u, wd[1] = 0u, wd[2] = 0u, wd[3] = 0u;
    uint pos = 0u;
    put(pos, 0x40u, 7u);   // mode 6
    for (int ch = 0; ch < 4; ch++) {
        put(pos, q0[ch], 7u);
        put(pos, q1[ch], 7u);
    }
    put(pos, p0, 1u);
    put(pos, p1, 1u);
    put(pos, best_idx[0], 3u);
    for (uint i = 1u; i < 16u; i++) put(pos, best_idx[i], 4u);
    blk[pc.out_base + id.z * pc.bslice + id.y * pc.bx + id.x] = uvec4(wd[0], wd[1], wd[2], wd[3]);
}
