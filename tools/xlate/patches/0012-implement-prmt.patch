+        // result byte i is byte (selector >> 4i) & 7 of {A (bytes 0-3), C (bytes 4-7)}; with bit 3 of that nibble set,
+        // the byte's sign bit replicated instead. A constant selector folds to shifts and masks. Written from PTX's
+        // prmt.b32 definition; the other modes stay unimplemented and say so.
+        private static void EmitPrmt(EmitterContext context, Operand srcA, Operand srcB, Operand srcC, int rd, PMode mode)
+        {
+            if (mode != 0)
+            {
+                context.TranslatorContext.GpuAccessor.Log($"Shader instruction Prmt mode {mode} is not implemented.");
+                return;
+            }
+
+            Operand result = Const(0);
+
+            for (int i = 0; i < 4; i++)
+            {
+                Operand nibble = context.BitwiseAnd(context.ShiftRightU32(srcB, Const(i * 4)), Const(0xf));
+                Operand index = context.BitwiseAnd(nibble, Const(7));
+                Operand shift = context.BitwiseAnd(context.ShiftLeft(index, Const(3)), Const(31));
+                Operand byteA = context.BitwiseAnd(context.ShiftRightU32(srcA, shift), Const(0xff));
+                Operand byteC = context.BitwiseAnd(context.ShiftRightU32(srcC, shift), Const(0xff));
+                Operand value = context.ConditionalSelect(context.ICompareLessUnsigned(index, Const(4)), byteA, byteC);
+                Operand negative = context.ICompareNotEqual(context.BitwiseAnd(value, Const(0x80)), Const(0));
+                Operand replicated = context.ConditionalSelect(negative, Const(0xff), Const(0));
+                Operand sign = context.ICompareNotEqual(context.BitwiseAnd(nibble, Const(8)), Const(0));
+                value = context.ConditionalSelect(sign, replicated, value);
+                result = context.BitwiseOr(result, context.ShiftLeft(value, Const(i * 8)));
+            }
+
+            context.Copy(GetDest(rd), result);
         }
 
