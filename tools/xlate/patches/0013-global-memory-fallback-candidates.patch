+        // OOT: the candidates of TryGenerateMultiTargetStorageOp's fallback: every word of the driver reserved constant
+        // buffer at a 16-byte boundary (the NVN storage buffer tables: {u64 address, u32 size} entries) the program reads.
+        private static void CollectFallbackCbs(GtsContext gtsContext, BasicBlock[] blocks)
+        {
+            foreach (BasicBlock block in blocks)
+            {
+                for (LinkedListNode<INode> node = block.Operations.First; node != null; node = node.Next)
+                {
+                    if (node.Value is not Operation operation)
+                    {
+                        continue;
+                    }
+
+                    for (int index = 0; index < operation.SourcesCount; index++)
+                    {
+                        Operand source = operation.GetSource(index);
+
+                        if (source.Type == OperandType.ConstantBuffer &&
+                            source.GetCbufSlot() == DriverReservedCb &&
+                            (source.GetCbufOffset() & 3) == 0)
+                        {
+                            uint packed = PackCbSlotAndOffset(DriverReservedCb, source.GetCbufOffset());
+
+                            if (!gtsContext.FallbackCbs.Contains(packed))
+                            {
+                                gtsContext.FallbackCbs.Add(packed);
+                            }
+                        }
+                    }
+                }
+            }
+
+            gtsContext.FallbackCbs.Sort();
+        }
